          "info": {
            "name": "Get bundles",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.opal.dev/v1/bundles",
            "params": [
              {
                "name": "page_size",
                "value": "200",
                "type": "query",
                "description": "The maximum number of bundles to return from the beginning of the list. Default is 200, max is 1000."
              },
              {
                "name": "cursor",
                "value": "cD0yMDIxLTAxLTA2KzAzJTNBMjQlM0E1My40MzQzMjYlMkIwMCUzQTAw",
                "type": "query",
                "description": "A cursor indicating where to start fetching items after a specific point."
              },
              {
                "name": "contains",
                "value": "Engineering",
                "type": "query",
                "description": "A filter for the bundle name."
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Returns a list of `Bundle` objects."
        },
