{
  "opencollection": "1.0.0",
  "info": {
    "name": "Opal access-rules users API",
    "version": "1.0"
  },
  "items": [
    {
      "info": {
        "name": "users",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "user",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.opal.dev/v1/user",
            "params": [
              {
                "name": "user_id",
                "value": "32acc112-21ff-4669-91c2-21e27683eaa1",
                "type": "query",
                "description": "The user ID of the user."
              },
              {
                "name": "email",
                "value": "johndoe@domain.org",
                "type": "query",
                "description": "The email of the user. If both user ID and email are provided, user ID will take precedence. If neither are provided, an error will occur."
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Returns a `User` object."
        },
        {
          "info": {
            "name": "getUsers",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.opal.dev/v1/users",
            "params": [
              {
                "name": "cursor",
                "value": "cD0yMDIxLTAxLTA2KzAzJTNBMjQlM0E1My40MzQzMjYlMkIwMCUzQTAw",
                "type": "query",
                "description": "The pagination cursor value."
              },
              {
                "name": "page_size",
                "value": "200",
                "type": "query",
                "description": "Number of results to return per page. Default is 200."
              },
              {
                "name": "tag_ids",
                "value": "",
                "type": "query",
                "description": "The IDs of the tags to filter by. Returns only users that have any of these tags applied."
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Returns a list of users for your organization."
        },
        {
          "info": {
            "name": "getRemoteUsers",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.opal.dev/v1/users/remote_users",
            "params": [
              {
                "name": "third_party_provider",
                "value": "GIT_HUB",
                "type": "query",
                "description": "Filter remote users by their third party provider."
              },
              {
                "name": "user_id",
                "value": "32acc112-21ff-4669-91c2-21e27683eaa1",
                "type": "query",
                "description": "Filter remote users by their user ID."
              },
              {
                "name": "remote_id",
                "value": "1234567890",
                "type": "query",
                "description": "Filter remote users by their remote ID."
              },
              {
                "name": "cursor",
                "value": "cD0yMDIxLTAxLTA2KzAzJTNBMjQlM0E1My40MzQzMjYlMkIwMCUzQTAw",
                "type": "query",
                "description": "The pagination cursor value."
              },
              {
                "name": "page_size",
                "value": "200",
                "type": "query",
                "description": "Number of results to return per page. Default is 200."
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Returns a list of remote users for your organization."
        },
        {
          "info": {
            "name": "get_user_tags",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.opal.dev/v1/users/:user_id/tags",
            "params": [
              {
                "name": "user_id",
                "value": "1b978423-db0a-4037-a4cf-f79c60cb67b3",
                "type": "path",
                "description": "The ID of the user whose tags to return."
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Returns all tags applied to the user."
        }
      ]
    }
  ],
  "bundled": true
}