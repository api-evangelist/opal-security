{
  "opencollection": "1.0.0",
  "info": {
    "name": "Opal access-rules opal-queries API",
    "version": "1.0"
  },
  "items": [
    {
      "info": {
        "name": "opal-queries",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Run an ad-hoc OpalQuery",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.opal.dev/v1/queries/run",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Runs an ad-hoc OpalQuery and returns the results. Currently supports NODE queries (users, resources, groups). This endpoint is only available to our OpalQuery beta group. Please contact Opal support if you'd like to be added to the beta."
        }
      ]
    }
  ],
  "bundled": true
}