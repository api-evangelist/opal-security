{
  "opencollection": "1.0.0",
  "info": {
    "name": "Opal access-rules apps API",
    "version": "1.0"
  },
  "items": [
    {
      "info": {
        "name": "apps",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get apps",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.opal.dev/v1/apps",
            "params": [
              {
                "name": "app_type_filter",
                "value": "OKTA_DIRECTORY,GIT_HUB",
                "type": "query",
                "description": "A list of app types to filter by."
              },
              {
                "name": "owner_filter",
                "value": "29827fb8-f2dd-4e80-9576-28e31e9934ac",
                "type": "query",
                "description": "An owner ID to filter by."
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Returns a list of `App` objects."
        },
        {
          "info": {
            "name": "Get app by ID",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.opal.dev/v1/apps/:app_id",
            "params": [
              {
                "name": "app_id",
                "value": "32acc112-21ff-4669-91c2-21e27683eaa1",
                "type": "path",
                "description": "The ID of the app."
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Returns an `App` object."
        },
        {
          "info": {
            "name": "getSyncErrors",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.opal.dev/v1/sync_errors",
            "params": [
              {
                "name": "app_id",
                "value": "29827fb8-f2dd-4e80-9576-28e31e9934ac",
                "type": "query",
                "description": "The ID of the app to list sync errors for."
              },
              {
                "name": "resource_id",
                "value": "4baf8423-db0a-4037-a4cf-f79c60cb67a5",
                "type": "query",
                "description": "The ID of the resource to list sync errors for."
              },
              {
                "name": "group_id",
                "value": "9546209c-42c2-4801-96d7-9ec42df0f59c",
                "type": "query",
                "description": "The ID of the group to list sync errors for."
              }
            ],
            "auth": {
              "type": "bearer",
              "token": "{{bearerToken}}"
            }
          },
          "docs": "Returns a list of recent sync errors that have occurred since the last successful sync."
        }
      ]
    }
  ],
  "bundled": true
}